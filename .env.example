# Supabase public project settings. The publishable key is safe for browser use,
# but production values should still be managed through Vercel Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secret. Never prefix this variable with VITE_ or expose it to the browser.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash

# Backend behavior
GEMINI_TIMEOUT_SECONDS=25
SUPABASE_TIMEOUT_SECONDS=8
CHAT_CONTEXT_LIMIT=5
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Frontend public settings (used later by the Vite app)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

